# ==========================================
# LLM Provider Configuration
# Choose: 'ollama' or 'huggingface'
# ==========================================
LLM_PROVIDER=ollama

# --- Ollama Settings (Local AI Model) ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434

# --- Hugging Face Transformers Settings ---
# HF_TOKEN is required when using Hugging Face Inference API
HF_TOKEN=your_huggingface_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Set to 'true' to load and run a local transformers pipeline with PyTorch
HF_USE_LOCAL=false
